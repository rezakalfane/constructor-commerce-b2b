# Copy to .env.local and fill in. Never commit real values.

# --- Amplience (delivery, read only; no secret needed) ----------------------
AMPLIENCE_HUB_NAME=
# production -> <hub>.cdn.content.amplience.net (published content, the default); preview -> <id>.staging.bigcontent.io (enables /preview)
AMPLIENCE_DELIVERY_HOST=
# Preview deployments only
AMPLIENCE_TIME_TOKEN=
WARM_TOKEN=
# Management (seeding scripts only, never used by the storefront)
AMPLIENCE_PAT=
AMPLIENCE_HUB_ID=

# --- BigCommerce (Storefront GraphQL, channel-scoped token) -----------------
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=

# --- Constructor -------------------------------------------------------------
# The index key (public: it also goes to the browser for tracking). Search, Browse, Autocomplete and tracking events use it.
CONSTRUCTOR_INDEX_KEY=
# Show the Constructor debug panel (on by default in development)
CIO_DEBUG=
# Storefront A/B test: set to "battery" to split visitors 50/50 (group B gets segment ab-battery-b). Unset = off. See docs/constructor.md.
CIO_AB_TEST=
# Behavioral tracking: on in production by default; on = also locally, off = never
CIO_TRACKING=
# API token (scripts/ only: load the catalog, configure facets and rules). The storefront never reads it.
CONSTRUCTOR_API_TOKEN=

# Checkout: the demo checkout (default) or BigCommerce's hosted page (bigcommerce)
CHECKOUT_MODE=
